  "conflicts": [
    {
      "id": "unoccupied_but_primary",
      "when": "months_unoccupied >= 3 and dwelling_use_type == \"Primary\"",
      "message": "unoccupied for 3+ months but claims primary residence"
    },
    {
      "id": "short_term_rental_but_primary",
      "when": "is_rental == \"Short-Term Rentals\" and dwelling_use_type == \"Primary\"",
      "message": "runs short-term rentals but claims primary residence"
    },
    {
      "id": "owner_occupied_but_secondary",
      "when": "dwelling_use_type == \"Secondary\" and dwelling_type in (\"Owner Occupied Single Family Residence\", \"Owner Occupied Multi Family Residence\")",
      "message": "owner-occupied dwelling type but use type is secondary"
    },
    {
      "id": "zero_residents_owner_occupied",
      "when": "number_of_residents < 1 and dwelling_type in (\"Owner Occupied Single Family Residence\", \"Owner Occupied Multi Family Residence\")",
      "message": "zero residents for an owner-occupied dwelling"
    },
    {
      "id": "roof_year_in_future",
      "when": "roof_replacement_year > current_year",
      "message": "roof replacement year is in the future"
    },
    {
      "id": "implausible_service_size",
      "when": "electrical_panel_size_amps < 60",
      "message": "implausibly small electrical service"
    },
    {
      "id": "zero_acreage",
      "when": "acreage <= 0",
      "message": "zero acreage"
    }
  ]
