{
  "note": "Trimmed registry for the take-home (a subset of the production schema). The agent triages a lead by joining each value in the lead payload against its definition here. The triage action is decided by the combination of (a) whether the value is present, (b) required level, and (c) editableByProducer.",
  "conventions": {
    "required": {
      "always": "Needed to quote. If missing, must be resolved now.",
      "conditional": "Required when a related field/condition is set (see requiredWhen).",
      "bind_only": "Not needed to quote; collect at bind. Safe to defer.",
      "no": "Optional."
    },
    "editableByProducer": "true = the producer/applicant can supply it (eligible for an email request). false = system-owned; the agent must auto-fetch/derive it from an internal/third-party service and must NOT ask a human.",
    "requiredWhen": "Condition under which a conditional field becomes required.",
    "missingDefault": "If present, the value the decision flow tells underwriters to assume when this field is missing (see FigJam stickies).",
    "consumers": "Which downstream systems need the field: general, rating, underwriting, cat_modeling.",
    "triage_rule": {
      "missing + editableByProducer:false": "auto-fetch / derive (no human)",
      "missing + editableByProducer:true + required:always|conditional": "request via email (producer/applicant)",
      "missing + required:bind_only": "defer to bind",
      "present but inconsistent/out-of-range": "verify (human)"
    }
  },
  "fields": {
    "street_address": { "label": "Property Address", "section": "Location", "type": { "kind": "address" }, "required": "always", "editableByProducer": true, "consumers": ["general"] },
    "city": { "label": "City", "section": "Location", "type": { "kind": "text" }, "required": "always", "editableByProducer": true, "consumers": ["general", "underwriting"] },
    "county": { "label": "County", "section": "Location", "type": { "kind": "text" }, "required": "always", "editableByProducer": true, "consumers": ["general", "rating", "underwriting"] },
