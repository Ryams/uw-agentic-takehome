    "zip": { "label": "Zip Code", "section": "Location", "type": { "kind": "text" }, "required": "always", "editableByProducer": true, "consumers": ["general", "rating", "underwriting"] },

    "broker_tier": { "label": "Broker Tier", "section": "Account", "type": { "kind": "select", "options": ["Tier 1", "Tier 2", "Tier 3"] }, "required": "conditional", "editableByProducer": false, "consumers": ["underwriting"] },
    "has_primary_policy_with_stand": { "label": "Insured has a primary policy with Stand", "section": "Account", "type": { "kind": "toggle" }, "required": "conditional", "editableByProducer": false, "consumers": ["underwriting"] },
    "listed_for_sale": { "label": "Property currently listed for sale", "section": "Account", "type": { "kind": "toggle" }, "required": "conditional", "editableByProducer": true, "consumers": ["underwriting"] },

