# Copy to .env to override defaults: `docker compose up` reads it automatically.
SEED=42          # fixed seed for a reproducible queue (blank = random, echoed in responses)
COUNT=10         # leads per queue
DIFFICULTY=mixed # easy | mixed | hard
DEBUG=false      # true exposes GET /leads/{id}/debug (the answer key)
VENDOR_PROFILE=demo  # demo (reliable mock vendors) | noisy (seeded unavailable/ambiguous results)
VENDOR_SEED=0
