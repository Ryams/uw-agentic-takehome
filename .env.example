# Copy to .env (gitignored). Never commit real keys.
ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys
ANTHROPIC_MODEL=claude-sonnet-5-5
# optional per-task overrides: ANTHROPIC_MODEL_INTERPRETER, ANTHROPIC_MODEL_COMPOSER, ANTHROPIC_MODEL_SUMMARIZER
LEADGEN_URL=http://localhost:8081
MAILBOX_URL=http://localhost:8025
VENDORS_URL=http://localhost:8082
# LLM backend: anthropic (API key above) | claude-code (your local Claude Code login, no key) | offline (rule-based stand-in).
# Unset: anthropic when ANTHROPIC_API_KEY is set. `make ui-cc` / `eval-cc` etc. set it for you. Never put login tokens here.
UW_LLM=
# claude-code backend only: concurrent `claude -p` calls (default 3) and the CLI binary if not on PATH
UW_CLAUDE_CODE_CONCURRENCY=3
CLAUDE_BIN=
